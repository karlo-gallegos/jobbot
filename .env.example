# Copy to /opt/jobbot/.env on head01 (chmod 600). Never commit the real file.
# Align these names with what run.sh / retailor.sh already read.

ANTHROPIC_API_KEY=
JOBBOT_MODEL_PACK=claude-opus-5-5      # tailoring CV Profile + cover letter
JOBBOT_MODEL_SCAN=claude-haiku-5-5     # re-checking listings and deadlines

NTFY_URL=https://ntfy.sh
NTFY_TOPIC=

JOBBOT_HOME=/opt/jobbot
JOBBOT_DATA=/opt/jobbot/data           # watchlist.json lives here
JOBBOT_OUT=/mnt/nas/Careers/CV/Jobbot  # packs sync here
JOBBOT_MASTER=/opt/jobbot/master       # cv_master.docx, letter_template.docx

DEADLINE_WINDOW_HOURS=36
