# Copy to config.env and edit.
# Pick a long random topic name: anyone who knows it can read your notifications.
NTFY_TOPIC=karlo-jobbot-CHANGE-ME-7f3k9
# Cheap model for searching, better model only for writing CV/cover-letter text.
SCAN_MODEL=haiku
TAILOR_MODEL=sonnet
# Optional: folder on the mounted Unraid share; out/ and tracker.md are copied here after each run,
# and watchlist.json, mail_events.json, inbox-archive.md to SYNC_DIR/state/ (daily + weekly).
SYNC_DIR=/mnt/unraid/jobbot
# Recruiter-email watch (mailwatch.py). Gmail address + an app password
# (Google Account → Security → 2-Step Verification → App passwords). Keep config.env chmod 600.
MAIL_USER=you@gmail.com
MAIL_APP_PASSWORD=abcd efgh ijkl mnop
# Model for reading flagged emails (default: SCAN_MODEL). "none" = no AI, just ping subjects.
#MAIL_MODEL=haiku
# Optional Gmail label added to emails that produced a deadline/event/to-do (create it in Gmail first).
#MAIL_LABEL=Jobbot
# Extra sender domains/addresses always worth checking, and extra ones to ignore (comma-separated).
MAIL_EXTRA_SENDERS=mint-people.co.uk
#MAIL_IGNORE_SENDERS=example-newsletter.com
# How far back the first run looks.
MAIL_LOOKBACK_DAYS=3
