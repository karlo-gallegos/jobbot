# Copy to config.env and edit.
# Pick a long random topic name: anyone who knows it can read your notifications.
NTFY_TOPIC=karlo-jobbot-CHANGE-ME-7f3k9
# Cheap model for searching, better model only for writing CV/cover-letter text.
SCAN_MODEL=haiku
TAILOR_MODEL=sonnet
# Optional: folder on the mounted Unraid share; out/ and tracker.md are copied here after each run.
SYNC_DIR=/mnt/unraid/jobbot
