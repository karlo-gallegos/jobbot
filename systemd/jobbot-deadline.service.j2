# Managed by ansible/deploy.yml – edit in git, not on head01.
# If the tested unit from head01 differs, the head01 version wins: paste it over this.
[Unit]
Description=Jobbot deadline watch (build packs for roles closing soon, alert via ntfy)
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ jobbot_user }}
WorkingDirectory={{ jobbot_home }}
EnvironmentFile={{ jobbot_home }}/.env
ExecStart={{ jobbot_home }}/venv/bin/python {{ jobbot_home }}/bin/deadline_watch.py
TimeoutStartSec=15min
